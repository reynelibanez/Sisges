# Postgres local (ya lo tienes instalado; no usamos Docker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sisges

# Secreto para firmar la cookie de sesion (JWT). Cambialo por algo largo y random.
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Nombre de la cookie de sesion
SESSION_COOKIE_NAME=sisges_session
